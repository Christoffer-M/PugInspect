FROM node:24-alpine AS base
# corepack reads the pnpm version from package.json "packageManager"
RUN corepack enable

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/graphql-types/package.json ./packages/graphql-types/
COPY apps/backend/package.json ./apps/backend/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY packages/ ./packages/
COPY apps/backend/ ./apps/backend/
WORKDIR /app/apps/backend
RUN pnpm run build

FROM node:24-alpine AS runner
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/graphql-types/package.json ./packages/graphql-types/
COPY apps/backend/package.json ./apps/backend/
RUN pnpm install --frozen-lockfile --prod
COPY --from=build /app/apps/backend/dist ./apps/backend/dist
COPY --from=build /app/apps/backend/drizzle ./apps/backend/drizzle

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
# Owned before the volume mounts so the named volume inherits it — appuser
# can't append to a root-owned /logs.
RUN mkdir -p /logs && chown appuser:appgroup /logs
USER appuser

WORKDIR /app/apps/backend
EXPOSE 4000
CMD ["node", "dist/index.js"]
