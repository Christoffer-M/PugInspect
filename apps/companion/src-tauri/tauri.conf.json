{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PugInspect Companion",
  "version": "0.1.0",
  "identifier": "eu.puginspect.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PugInspect Companion",
        "width": 420,
        "height": 520,
        "minWidth": 420,
        "minHeight": 520,
        "maxWidth": 520,
        "maxHeight": 720,
        "decorations": false,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
