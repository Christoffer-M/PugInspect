{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PugInspect Companion",
  "version": "../package.json",
  "identifier": "eu.puginspect.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PugInspect Companion",
        "width": 420,
        "height": 520,
        "minWidth": 420,
        "minHeight": 520,
        "maxWidth": 520,
        "maxHeight": 720,
        "decorations": false,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREQjEyRTM2QjIxODM5QUQKUldTdE9SaXlOaTZ4VGRzbkt0bkt0Q096cnNMS0R0NDlXQUhaOEJNbGdsZWh3RTdGU3dMVGxUcysK",
      "endpoints": ["https://github.com/Christoffer-M/PugInspect/releases/download/companion-latest/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
