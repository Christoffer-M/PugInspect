{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "tsc",
    "dev": "pnpm run build && node dist/index.js",
    "start": "node dist/index.js",
    "codegen": "graphql-codegen --config codegen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "backfill:alt-links": "pnpm run build && node dist/scripts/backfill-alt-links.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@as-integrations/express5": "^1.1.2",
    "@repo/graphql-types": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "graphql": "^16.12.0",
    "graphql-parse-resolve-info": "^4.14.1",
    "graphql-tag": "^2.12.6",
    "pg": "^8.16.0",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.0.0",
    "@graphql-codegen/typescript": "5.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.8",
    "@graphql-codegen/typescript-resolvers": "5.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.13",
    "@types/pg": "^8.11.15",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.9.3"
  }
}
