{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "frontend", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "backend", "dev"],
      "port": 4000
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "frontend", "exec", "vite"],
      "port": 3020,
      "autoPort": true
    }
  ]
}
